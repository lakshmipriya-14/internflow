APP_NAME=InternFlow AI
APP_ENV=development

# Generate a real one (see README). Must be at least 32 characters.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# If your password has special characters, URL-encode them (@ becomes %40)
DATABASE_URL=postgresql+psycopg://internflow:internflow_pass@localhost:5432/internflow

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
